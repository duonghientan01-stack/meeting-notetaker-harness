# ==============================================================================
# Enterprise Meeting Intelligence Harness Environment Configuration
# ==============================================================================

# Monday.com API Token (Required for live sync, owner has permanent token)
# Set via platform secret store (Azure App Settings / Fly Secrets)
MONDAY_TOKEN=

# Happy Scribe Webhook Secret (HMAC-SHA256 signature verification)
# Must be set with a strong random secret. No default in code.
HAPPYSCRIBE_WEBHOOK_SECRET=

# Server Port
PORT=8000

# Budget Caps
BUDGET_CAP_PER_MEETING_USD=0.50
DAILY_BUDGET_CAP_USD=5.00

# Timezone reference for relative dates in meetings
DEFAULT_TIMEZONE=Asia/Hong_Kong
